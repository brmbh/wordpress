# Dependencies
node_modules/

# Build output (generated by `npm run build`)
assets/dist/

# Local project config (Figma keys, tokens) — copy from the .example
.brmbh-config.json

# Environments: brmbh.json is committed; brmbh.local.json overrides it per machine (ADR 009)
brmbh.local.json
# DB backups written before every import
.brmbh/
# Legacy env files (pre-1.4) — `brmbh update` moves them into brmbh.local.json
tools/env/*.env

# OS / editor cruft
.DS_Store
*.log
npm-debug.log*

# Local WP-CLI / sandbox artifacts
.debug-screenshots/

# Agent skill wrappers — generated from @brmbh/cli AGENTS/ on install
.claude/commands/
.cursor/rules/
.windsurf/rules/
