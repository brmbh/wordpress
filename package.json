{
  "name": "@brmbh/cli",
  "version": "0.1.0",
  "description": "The brmbh agentic WordPress suite CLI — scaffold a modern Bootstrap 5 + Gutenberg + ACF block-factory theme with built-in agent skills, then build, deploy, and sync from one command.",
  "type": "module",
  "bin": {
    "brmbh": "bin/brmbh.js",
    "create-brmbh": "bin/create-brmbh.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "skills",
    "skills.sh.json"
  ],
  "scripts": {
    "brmbh": "node bin/brmbh.js",
    "test": "node --test test/"
  },
  "keywords": [
    "wordpress",
    "wp-cli",
    "acf",
    "gutenberg",
    "bootstrap",
    "scaffold",
    "agentic",
    "ai-agents",
    "theme"
  ],
